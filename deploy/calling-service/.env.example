# Copy to .env. Do not commit .env or put secrets in server-config.json.
# Use the actual IPv4 address of the Docker host on the LAN; do not use 127.0.0.1.
CALLING_MEDIA_IP=192.168.1.10
CALLING_MEDIA_BIND_IP=0.0.0.0
CALLING_PUBLIC_HOST=call.lan
CALLING_FRONTEND_LOCAL_PORT=8095

# Generate with: openssl rand -hex 32
# This key authenticates Signal RingRTC group-call requests to the Calling Frontend.
CALLING_AUTH_KEY=

# Base64-encoded GenericServerSecretParams for the exact same calling ZK config
# whose matching public parameters are installed in the Signal Android app build.
# Do not use the upstream sample/test parameters.
CALLING_ZK_PARAMS=

# Must be identical to turn.local.sharedSecret in Signal Server's private YAML config.
# Generate a different random 32-byte secret with: openssl rand -hex 32
TURN_STATIC_AUTH_SECRET=
TURN_REALM=signal.lan
