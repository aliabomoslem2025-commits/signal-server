# Copy to .env. Keep the generated values private and do not commit .env.

# Public LAN HTTPS origin routed to the TUS service by the reverse proxy.
TUS_PUBLIC_BASE_URL=https://cdn3.lan
TUS_LOCAL_PORT=8096

# Generate with: openssl rand -base64 32
# This must be the exact same decoded 32-byte secret as tus.userAuthenticationTokenSharedSecret
# in Signal Server's private configuration.
TUS_SHARED_AUTH_SECRET_BASE64=

# Generate independent strong MinIO root credentials and a restricted TUS service user.
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1

MINIO_API_LOCAL_PORT=9000
MINIO_CONSOLE_LOCAL_PORT=9001
MAX_UPLOAD_BYTES=2000000000
