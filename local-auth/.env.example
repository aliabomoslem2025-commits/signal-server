# Copy to .env and replace every value with an independent secret.
# Generate each value with: openssl rand -hex 32
LOCAL_AUTH_DB_PASSWORD=REPLACE_WITH_RANDOM_64_HEX_CHARS
LOCAL_AUTH_ADMIN_TOKEN=REPLACE_WITH_RANDOM_64_HEX_CHARS
LOCAL_AUTH_INTERNAL_TOKEN=REPLACE_WITH_RANDOM_64_HEX_CHARS
LOCAL_AUTH_TICKET_HMAC_SECRET=REPLACE_WITH_RANDOM_64_HEX_CHARS
LOCAL_AUTH_ANDROID_ID_HASH_SECRET=REPLACE_WITH_RANDOM_64_HEX_CHARS

# Exact browser origin(s) that may call the dashboard API. No wildcard.
LOCAL_AUTH_ALLOWED_ORIGINS=https://dashboard.lan
